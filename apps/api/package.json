{
  "name": "@guri/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @guri/shared build && prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:promote": "node --env-file=../../.env scripts/promote-admin.mjs",
    "db:seed-test": "node --env-file=../../.env scripts/seed-testdata.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@guri/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.7.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/node": "^10.65.0",
    "jose": "^4.15.9",
    "nestjs-pino": "^4.6.1",
    "pg-boss": "^12.26.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.7.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
