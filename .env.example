# Copy to .env and adjust. Never commit the real .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=guri
POSTGRES_PASSWORD=guri_dev_password
POSTGRES_DB=guri
POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgresql://guri:guri_dev_password@localhost:5432/guri?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Clerk (auth is Clerk, SPEC §11 v1.9 — get keys at dashboard.clerk.com) ---
# Enable Google OAuth + email/password in the Clerk dashboard. Do NOT enable
# phone/SMS auth (billed per message).
# (the default below is a format-valid placeholder so builds pass — sign-in
# only works once you paste your real keys)
CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuY2xlcmsuYWNjb3VudHMuZGV2JA==
CLERK_SECRET_KEY=sk_test_replace-me
# Webhooks → add endpoint <api-url>/webhooks/clerk (events: user.*), then copy:
CLERK_WEBHOOK_SECRET=whsec_replace-me
# Same publishable key, exposed to the Next.js client:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cGxhY2Vob2xkZXIuY2xlcmsuYWNjb3VudHMuZGV2JA==

# Platform admins (SPEC §2): comma-separated email allowlist — never self-serve
PLATFORM_ADMIN_EMAILS=admin@example.com

# --- Object storage (MinIO locally; Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=guri
S3_SECRET_ACCESS_KEY=guri_dev_secret
S3_BUCKET=guri
S3_FORCE_PATH_STYLE=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Absolute origin used for canonical URLs, OG tags, robots and the sitemap.
NEXT_PUBLIC_SITE_URL=https://getguri.com

# Backup dump binary (§8). Prod: pg_dump. Local: docker exec guri-postgres pg_dump
PG_DUMP_CMD=pg_dump

# --- Monitoring (§9) — Sentry is DSN-gated; leave blank to disable ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug
